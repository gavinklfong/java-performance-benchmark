        <mxCell id="dSNsxEPMi_TIOLcG1K3F-137" value="&lt;div&gt;# JMH version: 1.37&lt;/div&gt;&lt;div&gt;# VM version: JDK 21.0.7, OpenJDK 64-Bit Server VM, 21.0.7&lt;/div&gt;&lt;div&gt;# VM invoker: /home/linuxbrew/.linuxbrew/Cellar/openjdk@21/21.0.7/libexec/bin/java&lt;/div&gt;&lt;div&gt;# VM options: -javaagent:/snap/intellij-idea-community/675/lib/idea_rt.jar=35541 -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8&lt;/div&gt;&lt;div&gt;# Blackhole mode: compiler (auto-detected, use -Djmh.blackhole.autoDetect=false to disable)&lt;/div&gt;&lt;div&gt;# Warmup: 5 iterations, 1 s each&lt;/div&gt;&lt;div&gt;# Measurement: 8 iterations, 1 s each&lt;/div&gt;&lt;div&gt;# Timeout: 10 min per iteration&lt;/div&gt;&lt;div&gt;# Threads: 4 threads, will synchronize iterations&lt;/div&gt;&lt;div&gt;# Benchmark mode: Throughput, ops/time&lt;/div&gt;&lt;div&gt;# Benchmark: com.example.ListReadBenchmark.arrayListRead&lt;/div&gt;&lt;div&gt;# Parameters: (size = 1000)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# Run progress: 0.00% complete, ETA 00:13:00&lt;/div&gt;&lt;div&gt;# Fork: 1 of 5&lt;/div&gt;&lt;div&gt;# Warmup Iteration&amp;nbsp; &amp;nbsp;1: 0.024 ops/ns&lt;/div&gt;&lt;div&gt;# Warmup Iteration&amp;nbsp; &amp;nbsp;2: 0.024 ops/ns&lt;/div&gt;&lt;div&gt;# Warmup Iteration&amp;nbsp; &amp;nbsp;3: 0.025 ops/ns&lt;/div&gt;&lt;div&gt;# Warmup Iteration&amp;nbsp; &amp;nbsp;4: 0.025 ops/ns&lt;/div&gt;&lt;div&gt;# Warmup Iteration&amp;nbsp; &amp;nbsp;5: 0.025 ops/ns&lt;/div&gt;&lt;div&gt;Iteration&amp;nbsp; &amp;nbsp;1: 0.025 ops/ns&lt;/div&gt;&lt;div&gt;Iteration&amp;nbsp; &amp;nbsp;2: 0.025 ops/ns&lt;/div&gt;&lt;div&gt;Iteration&amp;nbsp; &amp;nbsp;3: 0.025 ops/ns&lt;/div&gt;&lt;div&gt;Iteration&amp;nbsp; &amp;nbsp;4: 0.025 ops/ns&lt;/div&gt;&lt;div&gt;Iteration&amp;nbsp; &amp;nbsp;5: 0.025 ops/ns&lt;/div&gt;&lt;div&gt;Iteration&amp;nbsp; &amp;nbsp;6: 0.025 ops/ns&lt;/div&gt;&lt;div&gt;Iteration&amp;nbsp; &amp;nbsp;7: 0.025 ops/ns&lt;/di